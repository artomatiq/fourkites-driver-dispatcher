#!/bin/bash
set -euxo pipefail

dnf -y update
dnf -y install python3 python3-pip

install -d -o root -g root /opt/worker
aws s3 cp "s3://${mail_bucket}/deploy/worker.py" /opt/worker/worker.py --region "${region}"
aws s3 cp "s3://${mail_bucket}/deploy/requirements.txt" /opt/worker/requirements.txt --region "${region}"

python3 -m pip install -r /opt/worker/requirements.txt

cat >/opt/worker/worker.env <<EOF
AWS_REGION=${region}
QUEUE_URL=${queue_url}
MAIL_BUCKET=${mail_bucket}
REPLY_FROM=${reply_from}
REPLY_TO=${reply_to}
BEDROCK_MODEL_ID=${bedrock_model_id}
SSM_PREFIX=${ssm_prefix}
EOF

cat >/etc/systemd/system/dispatch-worker.service <<'EOF'
[Unit]
Description=FourKites driver-dispatcher worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/worker/worker.env
ExecStart=/usr/bin/python3 /opt/worker/worker.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now dispatch-worker.service
